# Copy to .env in the repository root. .env is ignored by Git.
# Replace the placeholders before starting this production stack.
MONGO_ROOT_USER=mcapadmin
# Generate with: openssl rand -hex 24 (hex needs no URI escaping).
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
MINIO_ROOT_USER=mcapstorage
# Generate a DIFFERENT password with: openssl rand -hex 24
MINIO_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_PASSWORD
AWS_REGION=us-east-1
AWS_S3_RUN_BUCKET=vehicle-runs

# Obtain the deployment HOST's DNS name using tailscale status --json.
# Use HTTPS and :8443. No /s3, bucket name, or trailing slash.
AWS_S3_PUBLIC_ENDPOINT=https://lib-o-yap.tail937b5a.ts.net:8443

# Pin infrastructure images to tested release tags/digests for repeatable builds.
MONGO_IMAGE=mongo:7
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest
